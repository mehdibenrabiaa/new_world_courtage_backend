DATABASE_URL=sqlite:///./nwc.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://crm.newworldcourtage.fr,https://www.newworldcourtage.fr
SECRET_KEY=change-me-in-production

# Outbound email (SMTP) — leave blank to disable sending (app/email.py
# no-ops when SMTP_HOST is empty). Hostinger mailboxes: port 465 (implicit
# SSL) with SMTP_HOST=smtp.hostinger.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=New World Courtage <devis@newworldcourtage.com>

# IMAP — not read by any code yet (nothing checks the inbox today), kept
# here only so the credentials are in one place if/when that's built.
# Hostinger: imap.hostinger.com, port 993.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993

# Public-site accounts (Espace Client / Espace Partenaire) — where password
# reset links and OAuth redirects send the user back to.
FRONTEND_URL=http://localhost:3000

# Social sign-in — leave blank to disable that provider (its "Sign in with
# ..." button just shows a "not available yet" message). Each is a real
# OAuth app you register with the provider:
#   Google:   https://console.cloud.google.com/apis/credentials
#             redirect URI: {BASE_URL}/api/accounts/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#   Facebook: https://developers.facebook.com/apps
#             redirect URI: {BASE_URL}/api/accounts/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
#   Apple:    https://developer.apple.com/account/resources/identifiers
#             (a Services ID, not your app's bundle ID) + a Sign in with
#             Apple private key. redirect URI:
#             {BASE_URL}/api/accounts/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
